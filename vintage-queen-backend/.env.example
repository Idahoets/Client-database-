# Copy this file to .env and fill in real values. Never commit .env itself.

# Found in the Merchant Dashboard URL, e.g. https://www.clover.com/merchant/XXXXXXXXXXXXX
CLOVER_MERCHANT_ID=

# The access token generated when you install your private app on your own merchant account (OAuth flow)
CLOVER_ACCESS_TOKEN=

# https://api.clover.com for production, https://sandbox.dev.clover.com for testing
CLOVER_API_BASE=https://api.clover.com

# Comma-separated Clover device ids whose orders count as estate-sale orders
# (40% commission, payout 7 days after the sale). Confirmed: this device is
# Sue Daniel's estate sale (order dates 6/26-6/27).
ESTATE_SALE_DEVICE_IDS=b74b1507-9fde-3484-d261-e8b82dfca0cc

# Comma-separated Clover device ids whose orders are skipped entirely - not
# counted as estate or storefront, not attributed to any consignor. This
# device is the 7/11 warehouse sale (174 orders): it used the same checkout
# style as an estate sale by coincidence, but it's a separate business line,
# not consignor business.
EXCLUDED_DEVICE_IDS=ef64d5a2-add0-2da4-571e-3f9752e8f41a

# Asana project this shop uses in place of a manual consignor spreadsheet
ASANA_PROJECT_ID=1212596660527241
# Personal access token (or service account token) for the Asana API
ASANA_TOKEN=

# Where the app runs
PORT=3000

# Local SQLite file - fine for a single-location shop, swap for Postgres later if needed
DB_PATH=./vintage-queen.db

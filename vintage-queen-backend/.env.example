# Copy this file to .env and fill in real values. Never commit .env itself.

# Found in the Merchant Dashboard URL, e.g. https://www.clover.com/merchant/XXXXXXXXXXXXX
CLOVER_MERCHANT_ID=

# The access token generated when you install your private app on your own merchant account (OAuth flow)
CLOVER_ACCESS_TOKEN=

# https://api.clover.com for production, https://sandbox.dev.clover.com for testing
CLOVER_API_BASE=https://api.clover.com

# Comma-separated Clover device ids whose orders count as estate-sale orders
# (everything else is treated as a storefront sale). Looking at real order
# history, the storefront register shows up on almost every business day,
# while two other devices each only appear for a single day or two - those
# are the estate-sale candidates. Confirm which sale(s) they were before
# setting this, since it directly changes the commission rate (40% vs 50%)
# and payout timing applied to those sales:
#   ef64d5a2-add0-2da4-571e-3f9752e8f41a  (active only 2026-07-11, 174 orders)
#   b74b1507-9fde-3484-d261-e8b82dfca0cc  (active only 2026-06-26/27, 110 orders)
ESTATE_SALE_DEVICE_IDS=

# Where the app runs
PORT=3000

# Local SQLite file - fine for a single-location shop, swap for Postgres later if needed
DB_PATH=./vintage-queen.db
